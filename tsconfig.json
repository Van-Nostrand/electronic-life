{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "alwaysStrict": true,
    "baseUrl": "src",
    "esModuleInterop": true,
    "jsx": "react",
    "moduleResolution": "Node",
    "noImplicitAny": true,
    "outDir": "./dist/",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "strict": true,
    "sourceMap": true,
    "target": "ES2022"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
